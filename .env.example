# Example secrets file — copy to `.env` (gitignored) and adjust.
# Loaded automatically by `python-dotenv` or your shell, OR set these via
# your service manager (systemd EnvironmentFile=, Docker --env-file, etc).
#
# All settings are also configurable in config/tts-server.toml. Environment
# variables take precedence over the TOML file.

# 32-byte hex bearer token. Generate a fresh one for each deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
TTS_SERVER__AUTH_TOKEN=

# Override defaults if needed:
# TTS_SERVER__HOST=0.0.0.0
# TTS_SERVER__PORT=8880
# TTS_CONFIG_FILE=/etc/tts-server/server.toml
