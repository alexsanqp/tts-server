__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

data/refs/
data/*.wav
data/*.mp3
data/*.opus
data/*.tmp
!data/refs-catalog/

# Reference-audio catalog is operator-specific — each deployment supplies
# its own voices and metadata. Only `example.json` ships as a schema
# template; everything else stays local.
data/refs-catalog/*.mp3
data/refs-catalog/*.wav
data/refs-catalog/*.flac
data/refs-catalog/*.ogg
data/refs-catalog/*.json
!data/refs-catalog/example.json

cache/
*.log

.env
.env.local
.env.*.local

# Local config overrides — operator-specific secrets live here, never in
# the tracked tts-server.toml.
config/*.local.toml
config/secrets.toml

.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
