__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

data/refs/
data/*.wav
data/*.mp3
data/*.opus
data/*.tmp
!data/refs-catalog/

# Reference-audio binaries are operator-specific (may carry licensing
# constraints from third-party TTS platforms). JSON sidecars stay tracked
# as schema documentation; audio is provided by each deployment.
data/refs-catalog/*.mp3
data/refs-catalog/*.wav
data/refs-catalog/*.flac
data/refs-catalog/*.ogg

cache/
*.log

.env
.env.local
.env.*.local

# Local config overrides — operator-specific secrets live here, never in
# the tracked tts-server.toml.
config/*.local.toml
config/secrets.toml

.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
